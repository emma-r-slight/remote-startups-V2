{
  "name": "boilerplate-react-webpack",
  "version": "0.2.2",
  "description": "A webpack React starter",
  "repository": "https://github.com/dev-academy-challenges/boilerplate-react-webpack.git",
  "main": "server/index.js",
  "author": "EDA",
  "license": "ISC",
  "scripts": {
    "client": "webpack-dev-server --hot --inline",
    "dev": "run-p dev:client dev:server",
    "dev:client": "webpack --watch",
    "dev:server": "nodemon server",
    "start": "run-s build server",
    "build": "webpack",
    "server": "node server",
    "test": "jest --watchAll",
    "lint": "eslint client server",
    "lint:fix": "eslint client server --fix"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "plugins": [
      "@babel/plugin-proposal-class-properties",
      "@babel/plugin-proposal-object-rest-spread"
    ]
  },
  "jest": {},
  "dependencies": {
    "@hookform/resolvers": "^0.1.1",
    "@sendgrid/mail": "^8.1.2",
    "authenticare": "^0.4.7",
    "express": "^4.17.1",
    "grommet-icons": "^4.5.0",
    "nan": "^2.14.1",
    "npm-run-all": "^4.1.5",
    "superagent": "^5.3.1",
    "yup": "^0.32.10"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.12.1",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.12.1",
    "@testing-library/jest-dom": "^6.4.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^12.1.6",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^28.1.1",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.9.0",
    "dotenv": "^8.2.0",
    "eslint": "^8.46.0",
    "eslint-config-eda": "^0.3.1",
    "file-loader": "^6.1.0",
    "grommet": "^2.17.3",
    "jest": "^29.7.0",
    "knex": "^0.95.1",
    "nock": "^13.0.4",
    "nodemon": "^3.0.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-hook-form": "^6.9.5",
    "react-images-upload": "^1.2.8",
    "react-redux": "^7.2.1",
    "react-spring": "^8.0.27",
    "redux": "^4.0.5",
    "sqlite3": "^5.0.3",
    "style-loader": "^3.0.0",
    "styled-components": "^6.1.0",
    "supertest": "^4.0.2",
    "webpack": "^5.79.0",
    "webpack-cli": "^4.0.0",
    "webpack-dev-server": "^5.1.0"
  }
}
